ARG image
ARG image_tag

FROM ${image}:${image_tag}

# Some older base images (RHEL/CentOS 8) ship yum but not dnf.
RUN command -v dnf >/dev/null 2>&1 || yum install -y dnf

# --nobest: tolerate temporarily out-of-sync BaseOS/AppStream mirrors
# during distribution point releases.
RUN dnf -y update --nobest \
 && dnf -y install \
        autoconf \
        clang \
        m4 \
        make \
        ncurses-devel \
        openssl-devel \
        rpm-build \
        rpmdevtools \
        systemd-devel \
        tar \
        wget \
        zlib-devel \
 && (dnf -y install rpmlint || true) \
 && dnf clean all \
 && rm -rf /var/cache/dnf

RUN mkdir -p /build/pkg-build-dir
WORKDIR /build/pkg-build-dir

CMD ["make"]
